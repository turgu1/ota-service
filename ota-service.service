[Unit]
Description=OTA Service for ESPHome Devices
Documentation=https://github.com/turgu1/ota-service
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=ota-service
Group=ota-service
WorkingDirectory=/var/lib/ota-service
ExecStart=/usr/local/bin/ota-service /etc/ota-service/config.yaml

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ota-service /var/log/ota-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Restart behavior
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ota-service

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
